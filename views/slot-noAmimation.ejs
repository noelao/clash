<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        /* --- CSS LANGSUNG DI SINI --- */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #1a1a1a;
            margin: 0;
            color: white;
        }

        .slot-machine {
            background: linear-gradient(145deg, #2c3e50, #000000);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 0 50px rgba(0,0,0,0.8);
            text-align: center;
            border: 4px solid #ffd700;
            max-width: 500px;
        }

        .reels {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 30px 0;
        }

        .reel {
            width: 120px;
            height: 120px;
            background: #fff;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            border: 3px solid #444;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.5);
        }

        .reel img {
            width: 90%;
            height: 90%;
            object-fit: contain;
        }

        button {
            background: linear-gradient(#f1c40f, #d4ac0d);
            color: #000;
            border: none;
            padding: 15px 40px;
            font-size: 1.5rem;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 0 #91770b;
            transition: 0.1s;
        }

        button:active {
            transform: translateY(3px);
            box-shadow: 0 2px 0 #91770b;
        }

        button:disabled {
            background: #555;
            color: #888;
            box-shadow: none;
            cursor: not-allowed;
        }

        .result {
            margin-top: 25px;
            font-size: 1.5rem;
            height: 30px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="slot-machine">
        <h1 style="color: #ffd700; margin-top: 0;">COC SLOT</h1>
        
        <div class="reels">
            <div class="reel" id="reel1"><img></div>
            <div class="reel" id="reel2"><img></div>
            <div class="reel" id="reel3"><img></div>
        </div>

        <button id="spinBtn">SPIN!</button>
        <div id="result" class="result"></div>
    </div>

    <script>
        const reels = [
            document.querySelector('#reel1 img'),
            document.querySelector('#reel2 img'),
            document.querySelector('#reel3 img')
        ];
        const spinBtn = document.querySelector('#spinBtn');
        const resultDiv = document.querySelector('#result');

        let imageList = [];

        // 1. Ambil data dari API yang kita buat di routes/api.js
        async function init() {
            try {
                const res = await fetch('/api/data/pasukan');
                const data = await res.json();
                
                // Ratakan struktur nested menjadi array path saja
                function flatten(node) {
                    let files = [];
                    if (node.type === 'file') files.push('/' + node.path);
                    else if (node.children) {
                        node.children.forEach(c => files = files.concat(flatten(c)));
                    }
                    return files;
                }
                
                imageList = flatten(data);

                // Set gambar awal secara acak
                reels.forEach(img => {
                    img.src = imageList[Math.floor(Math.random() * imageList.length)];
                });
            } catch (e) {
                console.error("Gagal mengambil data gambar:", e);
            }
        }

        // 2. Logika Spin
        async function spin() {
            if (imageList.length === 0) return;

            spinBtn.disabled = true;
            resultDiv.innerText = "Memutar...";
            resultDiv.style.color = "white";

            // Efek berputar acak
            let counter = 0;
            const interval = setInterval(() => {
                reels.forEach(img => {
                    img.src = imageList[Math.floor(Math.random() * imageList.length)];
                });
                counter++;
                if (counter > 20) { // Berhenti setelah 20 kali acak
                    clearInterval(interval);
                    checkWinner();
                }
            }, 100);
        }

        function checkWinner() {
            const results = reels.map(img => img.src);
            spinBtn.disabled = false;

            if (results[0] === results[1] && results[1] === results[2]) {
                resultDiv.innerText = "JACKPOT! 🎉";
                resultDiv.style.color = "#2ecc71";
            } else {
                resultDiv.innerText = "Coba Lagi!";
                resultDiv.style.color = "#e74c3c";
            }
        }

        spinBtn.addEventListener('click', spin);
        init();
    </script>
</body>
</html>